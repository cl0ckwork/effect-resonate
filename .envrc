source_up

export EFFECT_RESONATE_ROOT_DIR="$PWD"

# Keep the pinned toolchain and repository commands available to shells, hooks,
# and agents without provisioning anything during a directory change.
PATH_add "$HOME/.local/share/mise/shims"

# pnpm 12 is a native binary. Its installer uses these platform-specific homes;
# prefer one when present because older Corepack/pnpm launchers cannot delegate
# reliably to the v12 package.
if [[ -x "$HOME/Library/pnpm/bin/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  PATH_add "$PNPM_HOME/bin"
elif [[ -x "$HOME/.local/share/pnpm/pnpm" ]]; then
  export PNPM_HOME="$HOME/.local/share/pnpm"
  PATH_add "$PNPM_HOME"
fi

PATH_add "$EFFECT_RESONATE_ROOT_DIR/node_modules/.bin"
PATH_add "$EFFECT_RESONATE_ROOT_DIR/scripts"

dotenv_if_exists .env
dotenv_if_exists .env.local

# Cheap and idempotent: expose the canonical .agents configuration to each tool.
source "$EFFECT_RESONATE_ROOT_DIR/scripts/setup-agent-symlinks.sh"
