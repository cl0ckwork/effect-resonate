{
  "name": "effect-resonate-workspace",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:types": "pnpm -r --if-present test:types",
    "test": "node --test tests/*.test.mjs && pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:types && pnpm build",
    "doctor": "bash scripts/doctor",
    "worktree-up": "bash scripts/worktree-up"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "effect": "4.0.0-rc.115",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "lefthook": "^2.1.14",
    "typescript-eslint": "8.70.0"
  }
}
