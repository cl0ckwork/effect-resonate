#!/bin/sh
# Git hooks do not load direnv. Prefer the native pnpm 12 installation, while
# retaining mise shims for Node and other developer tools when available.
if [ -x "$HOME/Library/pnpm/bin/pnpm" ]; then
  PATH="$HOME/Library/pnpm/bin:$PATH"
elif [ -x "$HOME/.local/share/pnpm/pnpm" ]; then
  PATH="$HOME/.local/share/pnpm:$PATH"
fi

if [ -d "$HOME/.local/share/mise/shims" ]; then
  PATH="$PATH:$HOME/.local/share/mise/shims"
fi

export PATH
