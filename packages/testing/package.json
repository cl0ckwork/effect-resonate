{
  "name": "@effect-resonate/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "zshy",
    "typecheck": "tsc -p tsconfig.dev.json --noEmit",
    "test:types": "tsc -p tsconfig.types.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect-resonate/core": "workspace:*",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@resonatehq/sdk": "^0.11.4",
    "typescript": "5.9.2",
    "vitest": "5.0.1",
    "zshy": "^0.7.2"
  },
  "zshy": {
    "cjs": false,
    "exports": {
      ".": "./src/index.ts"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
