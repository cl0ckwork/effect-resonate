{
  "name": "@effect-resonate/network-postgres",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "zshy",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tsconfig.types.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@effect-resonate/core": "0.0.0",
    "@resonatehq/sdk": "^0.11.4",
    "effect": "4.0.0-rc.115",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@effect-resonate/core": "workspace:*",
    "@resonatehq/sdk": "^0.11.4",
    "@types/pg": "^8.11.10",
    "effect": "4.0.0-rc.115",
    "pg": "^8.13.1",
    "typescript": "5.9.2",
    "vitest": "5.0.1",
    "zshy": "^0.7.2"
  },
  "zshy": {
    "cjs": false,
    "exports": {
      ".": "./src/index.ts",
      "./PostgresNetwork": "./src/PostgresNetwork.ts"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./PostgresNetwork": {
      "types": "./dist/PostgresNetwork.d.ts",
      "default": "./dist/PostgresNetwork.js"
    }
  }
}
